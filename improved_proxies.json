      "mocked_requests": {
        "/ajiocash/auth/login": {
          "POST": {
            "conditions": [],
            "responses": [
              {
                "when": [
                  { "field": "username", "operator": "exists", "source": "json" },
                  { "field": "username", "operator": "neq", "source": "json", "value": "" },
                  { "field": "password", "operator": "exists", "source": "json" },
                  { "field": "password", "operator": "neq", "source": "json", "value": "" }
                ],
                "then": {
                  "_store": [
                    { "path": "tokens.jsonget(username).accessToken", "value": "alnum(16,16)" },
                    { "path": "tokens.jsonget(username).refreshToken", "value": "alnum(16,16)" }
                  ],
                  "status_code": 200,
                  "body": {
                    "accessToken": "snippet(dbget('tokens.' + jsonget('username') + '.accessToken'))",
                    "expiresIn": 3600,
                    "refreshToken": "snippet(dbget('tokens.' + jsonget('username') + '.refreshToken'))"
                  }
                }
              }
            ],
            "default": {
              "status_code": 400,
              "body": { "error": "Missing credentials" }
            }
          }
        },
        "/ajiocash/auth/refreshtoken": {
          "POST": {
            "conditions": [],
            "responses": [
              {
                "when": [
                  {
                    "source": "snippet",
                    "value": "valid_refresh_token(jsonget('refreshToken', ''))"
                  }
                ],
                "then": {
                  "_store": [
                    { "path": "tokens.snippet(refresh_token_user(jsonget('refreshToken'))).accessToken", "value": "alnum(16,16)" },
                    { "path": "tokens.snippet(refresh_token_user(jsonget('refreshToken'))).refreshToken", "value": "alnum(16,16)" }
                  ],
                  "status_code": 200,
                  "body": {
                    "accessToken": "snippet(dbget('tokens.' + refresh_token_user(jsonget('refreshToken')) + '.accessToken'))",
                    "expiresIn": 3600,
                    "refreshToken": "snippet(dbget('tokens.' + refresh_token_user(jsonget('refreshToken')) + '.refreshToken'))"
                  }
                }
              }
            ],
            "default": {
              "status_code": 401,
              "body": { "error": "Invalid refresh token" }
            }
          }
        },
