      "api_domain": "http://10.21.87.97:9999",
      "_state_schema": {
        "tokens": { "<username>": { "accessToken": "<str>", "refreshToken": "<str>" } },
        "transactions": { "<transactionId>": { "amount": "<int>", "orderId": "<str>", "status": "<str>" } },
        "refunds": { "<refundTransactionId>": { "amount": "<int>", "transactionId": "<str>", "status": "<str>" } },
