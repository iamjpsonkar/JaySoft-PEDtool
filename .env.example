# PED Tools — copy this to .env and fill in your values
# cp .env.example .env

# Flask session secret key — generate with:
#   python -c 'import secrets; print(secrets.token_hex(32))'
PED_SECRET_KEY=

# UI login password (leave empty to disable login screen)
PED_UI_PASSWORD=

# API authentication token (leave empty to disable token auth)
PED_API_TOKEN=

# MongoDB — used for per-proxy state (dbget / _store)
PED_MONGO_URI=mongodb://localhost:27017
PED_MONGO_DB=pedapp

# SQLite database path (relative to project root)
PED_DB_PATH=pedapp.db

# Default AES encryption keys (hex/base64; used when secret/iv not provided per-request)
PED_DEFAULT_ENC_IV=
PED_DEFAULT_SECRET=

# Comma-separated allowed proxy target domains (leave empty to allow all)
PED_ALLOWED_PROXY_DOMAINS=

# Server settings
PED_PORT=8000
PED_DEBUG=false
PED_FORWARD_TIMEOUT=30
PED_HISTORY_LIMIT=100

# Rate limiting: max requests per window (0 = disabled)
PED_RATE_LIMIT_MAX=0
PED_RATE_LIMIT_WINDOW=60
